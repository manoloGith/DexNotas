<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- wgpu draws with Vulkan or OpenGL ES 3; glow (the fallback) needs OpenGL ES 3 too. -->
    <!-- The preview's WebView: images, fonts and scripts a Markdown or HTML document links to. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- A mouse and a keyboard are what DeX is for, but the app also starts without them. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DexNotas"
        android:resizeableActivity="true">

        <!-- Samsung DeX: keep the process when the window moves between the phone and the monitor
             or the density changes. -->
        <meta-data android:name="com.samsung.android.keepalive.density" android:value="true" />
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="true" />

        <!-- GameActivity subclass: winit receives every resize, density, keyboard and theme
             change as an event, so none of them may recreate the activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection|colorMode|touchscreen|mcc|mnc|fontWeightAdjustment">

            <meta-data android:name="android.app.lib_name" android:value="dexnotas" />

            <!-- A desktop-sized window when DeX or desktop windowing opens it in a freeform window. -->
            <layout
                android:defaultWidth="1280dp"
                android:defaultHeight="800dp"
                android:gravity="center"
                android:minWidth="640dp"
                android:minHeight="420dp" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" for text files from file managers, browsers and mail. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/x-sh" />
                <data android:mimeType="application/toml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/sql" />
            </intent-filter>

            <!-- Any file: DexNotas is always in "Open with" (DexFiles' and the system's), for a text
                 format or a language with an extension nobody declares. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- "Share" one or several text files to the app: they open in tabs. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
            </intent-filter>

            <!-- DexFiles' "Open" (DexFiles docs/apps-dex.md): DexFiles makes DexNotas the default app for
                 these extensions. First the tree-sitter languages, then the highlight.js ones, then
                 other text formats (a test checks that every extension DexNotas colours is here). -->
            <intent-filter>
                <action android:name="io.github.dexfiles.action.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="io.github.dexfiles.extensions"
                android:value="rs,py,pyi,pyw,c,cs,js,mjs,cjs,jsx,ts,mts,cts,tsx,json,jsonc,json5,jsonl,ndjson,geojson,webmanifest,har,md,markdown,mdx,mkd,mdown,sh,bash,zsh,ksh,ps1,psm1,psd1,go,java,swift,rb,rake,gemspec,php,phtml,cpp,cxx,cc,h,hpp,hxx,hh,ino,lua,html,htm,shtml,xht,vue,svelte,css,scss,yaml,yml,toml,ini,xml,svg,xhtml,xsl,xslt,xsd,wsdl,rss,atom,plist,csproj,vbproj,fsproj,props,targets,xaml,resx,kml,gpx,fxml,nuspec,config,sql,properties,bsl,as,adb,ads,ada,angelscript,apacheconf,htaccess,applescript,arcade,pde,arm,adoc,asciidoc,asc,aj,abnf,ahk,au3,awk,bnf,bas,bat,cmd,bf,cal,cls,capnp,ceylon,icl,dcl,clj,cljs,cljc,edn,cmake,coffee,cson,iced,crm,pcmk,cr,d,di,dart,pas,dpr,dfm,lpr,pp,dts,dtsi,diff,patch,jinja,j2,jinja2,djhtml,zone,dockerfile,dust,dst,ex,exs,elm,erb,erl,hrl,ebnf,fs,fsi,fsx,flix,f90,f95,f03,f08,f,for,f77,desktop,service,timer,socket,mount,target,gcode,gms,gss,feature,glsl,vert,frag,geom,gml,golo,gradle,graphql,gql,groovy,gvy,gy,haml,hbs,handlebars,mustache,hs,lhs,hx,hsp,http,hy,ni,i7x,asm,nasm,s,isbl,jl,kt,kts,ktm,lasso,tex,sty,ltx,bib,ldif,leaf,less,lisp,lsp,el,lc,ls,ll,lsl,mk,mak,make,wl,mma,wls,mac,mel,moo,rsc,mips,miz,ep,monkey,moon,n1ql,nt,nginxconf,nim,nims,nimble,nix,nsi,nsh,m,mm,ml,mli,scad,oxygene,pl,pm,pod,perl,pony,pgsql,pro,prolog,proto,pb,pbi,pycon,q,k,qml,r,rmd,re,rei,rib,rsl,sas,scala,sc,scm,ss,rkt,sci,sce,console,smali,st,sml,sig,sqf,stan,do,ado,stp,step,p21,styl,tcl,tk,tap,thrift,twig,vala,vapi,vbs,v,sv,svh,vhd,vhdl,vim,vimrc,vb,wat,wast,wren,xpp,xl,xq,xqm,xquery,xqy,zep,txt,text,log,cfg,conf,env,csv,tsv,tab,nfo,diz,srt,vtt,ass,rst,org,textile,lock,gitignore,gitattributes,gitmodules,editorconfig,dockerignore,npmignore,makefile,zig,tf,hcl,ics,vcf,reg,inf" />
        </activity>

        <!-- RestartActivity and the clipboard's FileProvider come from craft-activity's manifest. -->
    </application>
</manifest>
